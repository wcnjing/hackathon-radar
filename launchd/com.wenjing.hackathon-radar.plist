<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wenjing.hackathon-radar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>radar</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/wenjing/hackathon-radar</string>

    <!-- every 6 hours, matching the GitHub Actions schedule (SGT) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>2</integer>
            <key>Minute</key><integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>8</integer>
            <key>Minute</key><integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>20</integer>
            <key>Minute</key><integer>3</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/wenjing/hackathon-radar/logs/radar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wenjing/hackathon-radar/logs/radar.log</string>
</dict>
</plist>
