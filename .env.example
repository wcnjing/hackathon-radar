# Copy to .env and fill in. Never commit .env.

# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Your channel: "@yourchannelhandle" for public channels, or the numeric
# -100... id for private ones (run `uv run radar get-chat-id` to find it)
TELEGRAM_CHAT_ID=

# Optional but recommended: enables Claude relevance scoring.
# Without it, a simpler keyword scorer is used.
ANTHROPIC_API_KEY=
